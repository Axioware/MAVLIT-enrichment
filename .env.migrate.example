# Migration-only settings, read by `python -m pipeline.migrate` and by nothing else (not the API).
# Copy to .env.migrate on the server, then:   chown root:root .env.migrate && chmod 600 .env.migrate
# Never put these lines in .env or in mavlit.service's environment. The role must own the tables (mavlit_user).
MIGRATION_DATABASE_URL=postgresql+psycopg2://owner_user:password@localhost:5432/dbname
# Optional, once the restricted runtime role exists: re-grant it its planned access after each migration (see DB_PERMISSIONS.md).
# Also accepted as `--grant-role` or a MIGRATION_GRANT_ROLE variable of the migration process. Leave it commented to grant nothing.
# MIGRATION_GRANT_ROLE=mavlit_app
