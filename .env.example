DATABASE_URL=postgresql
APOLLO_API_KEY=
ENABLE_APOLLO_PHONE_REVEAL=false
META_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_1=
APIFY_TOKEN=
# Local SearXNG instance — website-discovery fallback in
# pipeline/enrichment_re/brand_instagram_profile.py. Requires JSON output
# enabled on the SearXNG instance (search.formats in its settings.yml must
# include "json" — disabled by default).
SEARXNG_URL=http://localhost:8080
ENABLE_LLM=false
OPENAI_KEY=
EMBEDDING_MODEL=text-embedding-3-small
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
# REQUIRED, 32+ characters (the application refuses to start otherwise): signs the login cookie.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
# REQUIRED, 32+ characters and different from JWT_SECRET: signs the /admin session cookie. Changing it (or ADMIN_PASSKEY) ends every admin session.
ADMIN_SESSION_SECRET=
# Login cookie: SameSite is Lax by default (right when the frontend and the API are on the same site, e.g. app.mavlit.com + api.mavlit.com).
# A frontend on a DIFFERENT site needs COOKIE_SAMESITE=none (production only, it makes the cookie Secure). COOKIE_DOMAIN is unset (host-only);
# set it (e.g. .mavlit.com) only if subdomains must share the login. Bcrypt cost of new password hashes: BCRYPT_ROUNDS (10-16, default 12);
# an older, cheaper hash is upgraded when its owner logs in.
# Login lifetime in days (JWT exp and cookie max-age both come from it; default 30, allowed 1-365).
# ACCESS_TOKEN_DAYS=30
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
# BCRYPT_ROUNDS=12
# Comma-separated origins of a separate cross-origin frontend app (no
# trailing slash), e.g. https://app.example.com,http://localhost:5173
# Enables CORS for those origins; also the only other origins allowed to send POST/PUT/PATCH/DELETE with the login cookie (CSRF check in
# api/app.py). If a reverse proxy does not pass the original Host header, add the public site origin here too.
# Enables CORS + cookie login for those origins. Leave empty if
# only using the same-origin frontend/*.html pages served by this API.
FRONTEND_ORIGINS=
# The operator credential: one shared secret (use a long random ASCII value, 12+ characters). It is the Password of the /admin login
# form AND the bearer token for the operator endpoints (/seed, /enrich/signals, /score/brands, /content-creator-re/bulk-add and their
# status routes): `Authorization: Bearer <ADMIN_PASSKEY>`. Left empty or blank, /admin and those endpoints are CLOSED to everyone.
# For local development only, ADMIN_ALLOW_UNAUTHENTICATED=1 leaves /admin open when this is empty (ignored when ENVIRONMENT=production).
ADMIN_PASSKEY=
# Optional: a separate Bearer credential for the operator endpoints. Unset = ADMIN_PASSKEY keeps working there. Set = only this one does there
# (and ADMIN_PASSKEY stays the /admin password). In production both must be 16+ characters when set. Five wrong attempts lock a client out
# for 15 minutes (database-backed, per client address) on /admin and on those endpoints.
# OPERATOR_PASSKEY=

# Database migrations (see MIGRATIONS.md).
# RUN_MIGRATIONS: 1 (default) = the API runs the migrations at startup, as always; 0 = it skips them, so run
#   `python -m pipeline.migrate` when the schema changes. Accepted: 1/true/yes/on or 0/false/no/off.
# The schema owner's URL (MIGRATION_DATABASE_URL) does NOT belong here: it goes in the root-only file .env.migrate
# (see .env.migrate.example). The API never reads it.
# RUN_MIGRATIONS=1

# Database connection pool of one process (pipeline/db.py). The cap is DB_POOL_SIZE + DB_MAX_OVERFLOW connections; the API uses the defaults below
# (15). Every process that imports pipeline.db (the API, run_*.py, enrichment CLIs) gets its own pool, so when you run several at once keep
# their sum, plus the API's 15 (30 while a restart drains), under the server's max_connections minus its reserved slots.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# The API process also holds a second, fixed pool for its long background jobs (seed, enrichment, scoring, AI ranking, descriptions):
# 2 connections (BatchSessionLocal, pipeline/db.py). So the API process totals 15 + 2 = 17 (34 while a restart drains).

# Batch runners and schema scripts (main.py, run_*.py, gender_check/*, scripts/populate_test_niches.py, the embed_* scripts) must connect as the
# table OWNER once the API's DATABASE_URL above is the restricted role (mavlit_app). Keep the owner's URL in a root-only file that is NOT this
# one: /root/.mavlit-batch.env (chmod 600), containing a single DATABASE_URL=... line, and load it for that run only:
#   set -a; . /root/.mavlit-batch.env; set +a
#   python run_reverse_engineering.py ...
# They refuse to run as MAVLIT_RUNTIME_ROLE (default mavlit_app). `python -m pipeline.migrate` reads .env.migrate / MIGRATION_DATABASE_URL instead.
# MAVLIT_RUNTIME_ROLE=mavlit_app

# Brand contacts (name, email, title) are shown only for brands the creator saved, is matched to, or added; at most this many DIFFERENT
# brands per creator per UTC day (counted in the database, table contact_reveals). 0 turns revealing off; a non-numeric value stops startup.
# CONTACT_REVEALS_PER_DAY=50

# Client address for the login lockout and the sign-up limit: the socket address, or CF-Connecting-IP when the connection comes from
# Cloudflare's published ranges. X-Forwarded-For is never trusted here. Add your own reverse proxy's address (comma separated CIDRs) only
# if it overwrites CF-Connecting-IP itself, e.g. TRUSTED_PROXY_CIDRS=127.0.0.1/32
# TRUSTED_PROXY_CIDRS=

# Server-side timeouts of every pipeline.db engine, in milliseconds (0 = off; a non-numeric value stops startup). Defaults suit the API.
# A batch runner / CLI that legitimately runs long queries sets larger values for that run, e.g.
#   DB_STATEMENT_TIMEOUT_MS=1800000 DB_IDLE_TX_TIMEOUT_MS=300000 python -m pipeline.enrichment...
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_TX_TIMEOUT_MS=60000
# DB_CONNECT_TIMEOUT=5            # seconds

# Per-user daily caps on the features that spend LLM / Apify money (counted in the database, UTC day, table feature_usage). Over the cap: HTTP 429
# with Retry-After, before any paid call. 0 turns that route off (HTTP 403); a non-numeric value stops startup.
# PITCHES_PER_DAY=30                    # POST /pitches and /pitches/stream together
# RATE_INTELLIGENCE_PER_DAY=20
# CONTRACT_ADVICE_PER_DAY=10
# MATCH_REFRESH_PER_DAY=10              # POST /matches/me/v2|v3/refresh that actually queue a ranking
# OWN_BRANDS_PER_DAY=10
# DESCRIPTION_GENERATIONS_PER_DAY=20    # a new description job (a job already running is returned, not counted)
# One pitch (or pitch stream) in flight per user: a second one is HTTP 409. A lock older than this many seconds (min 30) is taken over.
# PITCH_LOCK_STALE_SECONDS=300
# SAVED_BRANDS_MAX=500                  # brands one user can save (HTTP 409 beyond it)

# Request-body size limits in kilobytes (HTTP 413 JSON above them; 0 = no limit for that class; /admin and /static are exempt).
# BODY_LIMIT_KB=16                      # everything else
# BODY_LIMIT_KB_STANDARD=32             # PUT /creator-profile/me and the /pitches routes
# BODY_LIMIT_KB_LARGE=64                # POST /contract-advice and PATCH /pitches/{id}
# BODY_LIMIT_KB_BULK=256                # POST /content-creator-re/bulk-add

# List and query limits (read once at start; a bad value stops startup).
# MAX_OFFSET=10000                      # largest `offset` on /matches/me, /pitches/me, /saved-brands/me
# SAVED_BRANDS_PAGE_DEFAULT=100         # GET /saved-brands/me rows when `limit` is not given (the header X-Total-Count has the total)
# SAVED_BRANDS_PAGE_MAX=500             # largest `limit` there (the same as SAVED_BRANDS_MAX, so one page can hold every saved brand)
# BRAND_POSTS_LIMIT=200                 # rows read from each of the two post tables for /matches/me/brands/{id}/posts
# NICHE_CACHE_SECONDS=300               # the public niche lists are kept in memory this long; 0 = no cache
# NICHE_CACHE_MAX_KEYS=200              # at most this many different query-parameter combinations are cached
# ADMIN_EXPORT_MAX_ROWS=10000           # most rows a SQLAdmin export returns, on every view that allows export

# Outbound-call limits on request paths.
# APIFY_REQUEST_TIMEOUT_SECS=90         # Apify runs a person waits for (adding a post, a pitch that reads posts, a description, an own brand): run limit and wait. Batch jobs keep 600/630 s.
# PITCH_STREAM_DEADLINE_SECONDS=150     # a pitch stream is stopped after this long (the browser proxy gives up at 180 s)
# THUMBNAIL_MAX_BYTES=2097152           # a post picture larger than this is refused (HTTP 502)
