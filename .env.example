DATABASE_URL=postgresql
APOLLO_API_KEY=
ENABLE_APOLLO_PHONE_REVEAL=false
META_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_1=
APIFY_TOKEN=
# Local SearXNG instance — website-discovery fallback in
# pipeline/enrichment_re/brand_instagram_profile.py. Requires JSON output
# enabled on the SearXNG instance (search.formats in its settings.yml must
# include "json" — disabled by default).
SEARXNG_URL=http://localhost:8080
ENABLE_LLM=false
ENABLE_INSTA_LLM=false
OPENAI_KEY=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
JWT_SECRET=
# Comma-separated origins of a separate cross-origin frontend app (no
# trailing slash), e.g. https://app.example.com,http://localhost:5173
# Enables CORS + cross-site cookie login for those origins. Leave empty if
# only using the same-origin frontend/*.html pages served by this API.
FRONTEND_ORIGINS=
# Single shared passkey to access /admin — leave empty to leave /admin
# unprotected. Required before deploying anywhere reachable outside your
# own machine.
ADMIN_PASSKEY=